
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Mitoloji'nin Ruhu</title>
    <link rel="stylesheet" href="@(Url.Content("~/css/stylemyth.css"))" />
    <link rel="stylesheet" href="@(Url.Content("~/css/admin.css"))" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body id="@ViewData["BodyId"]">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

@if (currentController != "Admin")
{
    <nav class="navbar navbar-expand-md" id="custom-navbar">
        <div class="container">
            <!-- Hamburger butonu -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                    aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menü içeriği -->
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link">Ana Sayfa</a></li>
                    <li class="nav-item"><a asp-controller="MythCard" asp-action="Greek" class="nav-link">Antik Yunan</a></li>
                    <li class="nav-item"><a asp-controller="MythCard" asp-action="Egypt" class="nav-link">Antik Mısır</a></li>
                    <li class="nav-item"><a asp-controller="MythCard" asp-action="Nordik" class="nav-link">Nordik Mitoloji</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a asp-controller="Home" asp-action="Chat" class="nav-link">Sohbet Edelim</a></li>
                    <li class="nav-item"><a asp-controller="Home" asp-action="Contact" class="nav-link">İletişim</a></li>
                </ul>
            </div>
        </div>
    </nav>
}

@RenderBody()

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="@(Url.Content("~/js/main.js"))"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="@(Url.Content("~/js/main.js"))"></script>

@RenderSection("Scripts", required: false)

</body>
</html>
