<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mitoloji'nin Ruhu</title>
    <!-- CSS Dosyası -->
    <link rel="stylesheet" href="~/css/stylemyth.css" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body id="main-body">
    
    <div class="container mt-5 myth-text main-background">
        <h1 class="mb-4">Bize Ulaşın</h1>
        <p>
            Mitolojik dünyalar hakkında sorularınız, önerileriniz veya görüşleriniz mi var?
            Aşağıdaki formu doldurarak bize ulaşabilirsiniz. Efsaneler dünyasına dair merak ettiğiniz her şeyi sormaktan çekinmeyin!
        </p>
        
        <div class="row mt-4">
            <div class="col-md-6">
                <form id="contactForm">
                    <div class="mb-3">
                        <label for="name" class="form-label">Adınız</label>
                        <input type="text" class="form-control" id="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">E-posta Adresiniz</label>
                        <input type="email" class="form-control" id="email" required>
                    </div>
                    <div class="mb-3">
                        <label for="subject" class="form-label">Konu</label>
                        <select class="form-select" id="subject">
                            <option value="question">Soru</option>
                            <option value="suggestion">Öneri</option>
                            <option value="feedback">Geri Bildirim</option>
                            <option value="other">Diğer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">Mesajınız</label>
                        <textarea class="form-control" id="message" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Gönder</button>
                </form>
            </div>
            
            <div class="col-md-6">
                <div class="contact-info">
                    <h3><i class="fas fa-info-circle"></i> İletişim Bilgileri</h3>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-envelope"></i> Email: info@mitolojinindunyasi.com</li>
                        <li><i class="fas fa-phone"></i> Telefon: +90 555 123 45 67</li>
                        <li><i class="fas fa-map-marker-alt"></i> Adres: Mitoloji Sokak, Efsane Apt. No:12, İstanbul</li>
                    </ul>
                    
                    <div class="social-media mt-4">
                        <h4>Sosyal Medya</h4>
                        <a href="#" class="me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                    
                    
                </div>
            </div>
        </div>
    </div>

    <footer id="main-footer">
        <p>© 2025 Mitoloji'nin Ruhu. Tüm hakları saklıdır.</p>
    </footer>

    <!-- JavaScript Dosyaları -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+pmwGIk1p6LJIm+1eg1qXGxBv1z4" crossorigin="anonymous"></script>
    <script>
        // Form gönderim işlemi
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Form verilerini al
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const subject = document.getElementById('subject').value;
            const message = document.getElementById('message').value;
            
            // Burada form verilerini işleyebilir veya bir sunucuya gönderebilirsiniz
            console.log({
                name,
                email,
                subject,
                message
            });
            
            // Kullanıcıya geri bildirim
            alert('Mesajınız başarıyla gönderildi! En kısa sürede size dönüş yapacağız.');
            
            // Formu temizle
            this.reset();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+pmwGIk1p6LJIm+1eg1qXGxBv1z4"
        crossorigin="anonymous"></script>
    <script src="~/js/main.js"></script>
</body>

</html>