@model WebProje.Models.MythCard

<h2 style="color: black;">Yeni Hikaye Ekle</h2>

<form asp-action="Create" method="post" style="color: black;">
    <div class="form-group">
        <label style="color: black;">Başlık</label>
        <input asp-for="Baslik" class="form-control" style="color: black;" />
    </div>

    <div class="form-group">
        <label style="color: black;">Açıklama</label>
        <textarea asp-for="Aciklama" rows="5" class="form-control" style="color: black;"></textarea>
    </div>

    <div class="form-group">
        <label style="color: black;">Resim URL</label>
        <input asp-for="ResimUrl" class="form-control" style="color: black;" />
    </div>

    <div class="form-group">
        <label style="color: black;">Mitoloji Türü</label>
        <select asp-for="MitolojiTuru" class="form-control" style="color: black;">
            <option>Egypt</option>
            <option>Greek</option>
            <option>Nordik</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Kaydet</button>
</form>
